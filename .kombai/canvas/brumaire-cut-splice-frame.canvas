      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap');\n\n  :root {\n    --br-paper: #f1eee6;\n    --br-paper-soft: #f8f6f0;\n    --br-ink: #22211e;\n    --br-muted: #716d64;\n    --br-line: #cbc5b9;\n    --br-accent: #755642;\n  }\n\n  .br-display {\n    font-family: 'Instrument Serif', 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;\n  }\n\n  .br-mono {\n    font-family: 'DM Mono', 'Courier New', monospace;\n  }\n\n  .br-cut-void::before,\n  .br-cut-void::after {\n    content: '';\n    position: absolute;\n    left: 0;\n    right: 0;\n    height: 1px;\n    background: var(--br-paper);\n    opacity: 0.18;\n  }\n\n  .br-cut-void::before { top: 18%; }\n  .br-cut-void::after { bottom: 18%; }\n\n  .br-sprocket-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 0.75rem;\n    width: 100%;\n    padding-inline: 1rem;\n  }\n\n  .br-sprocket-row span {\n    display: block;\n    width: 0.65rem;\n    height: 0.65rem;\n    flex: 0 0 0.65rem;\n    background: var(--br-paper);\n  }\n\n  .br-crop-mark {\n    position: absolute;\n    width: 1.15rem;\n    height: 1.15rem;\n    border-color: var(--br-accent);\n    opacity: 0.9;\n  }\n\n  .br-crop-tl { top: -0.7rem; left: -0.7rem; border-top: 1px solid; border-left: 1px solid; }\n  .br-crop-tr { top: -0.7rem; right: -0.7rem; border-top: 1px solid; border-right: 1px solid; }\n  .br-crop-bl { bottom: -0.7rem; left: -0.7rem; border-bottom: 1px solid; border-left: 1px solid; }\n  .br-crop-br { right: -0.7rem; bottom: -0.7rem; border-right: 1px solid; border-bottom: 1px solid; }\n</style>\n<div class=\"min-h-screen bg-[var(--br-paper)] text-[var(--br-ink)] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-[var(--br-ink)] border-b px-5 sm:px-8 lg:px-12\" data-kid=\"1-1\" data-name=\"main header area\">\n        <div class=\"mx-auto flex min-h-[4.5rem] max-w-[1160px] items-stretch justify-between gap-6\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <a class=\"br-display flex min-h-11 items-center text-[1.65rem] leading-none tracking-[-0.045em] no-underline text-[var(--br-ink)]\" data-kid=\"1-1-1-1\" data-name=\"site brand name\" href=\"#\">\n                Brumaire\n            </a>\n            <div class=\"flex items-stretch\" data-kid=\"1-1-1-2\" data-name=\"header secondary content container\">\n                <div class=\"br-mono hidden items-center border-l border-[var(--br-line)] px-4 text-[0.62rem] tracking-[0.12em] text-[var(--br-accent)] sm:flex\" data-kid=\"1-1-1-2-1\" data-name=\"local status indicator\">\n                    LOCAL / 01\n                </div>\n                <nav aria-label=\"Primary navigation\" class=\"br-mono flex items-stretch text-[0.67rem] uppercase tracking-[0.08em]\" data-kid=\"1-1-1-2-2\" data-name=\"primary navigation menu\">\n                    <a class=\"flex min-h-11 items-center border-l border-[var(--br-line)] px-3 text-[var(--br-ink)] no-underline sm:px-4\" data-kid=\"1-1-1-2-2-1\" data-name=\"tool link\" href=\"#tool\">\n                        Tool\n                    </a>\n                    <a class=\"flex min-h-11 items-center border-x border-[var(--br-line)] px-3 text-[var(--br-ink)] no-underline sm:px-4\" data-kid=\"1-1-1-2-2-2\" data-name=\"privacy link\" href=\"#privacy\">\n                        Privacy\n                    </a>\n                </nav>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[1160px] px-5 pb-16 pt-12 sm:px-8 sm:pb-20 sm:pt-16 lg:px-0 lg:pt-20\" data-kid=\"1-2\" data-name=\"main content area\" id=\"tool\">\n        <section aria-labelledby=\"tool-title\" class=\"grid gap-10 lg:grid-cols-[minmax(0,1fr)_15rem] lg:items-end lg:gap-16\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div data-kid=\"1-2-1-1\" data-name=\"hero text container\">\n                <div class=\"br-mono mb-5 flex items-center gap-3 text-[0.64rem] uppercase tracking-[0.14em] text-[var(--br-accent)]\" data-kid=\"1-2-1-1-1\" data-name=\"hero tag line container\">\n                    <span class=\"inline-block h-2 w-2 bg-[var(--br-accent)]\" data-kid=\"1-2-1-1-1-1\" data-name=\"decorative color swatch\">\n                    </span>\n                    Video selection / reserved\n                </div>\n                <h1 class=\"br-display max-w-[12ch] text-[clamp(3.7rem,8vw,7.6rem)] italic leading-[0.88] tracking-[-0.045em] sm:max-w-[10ch]\" data-kid=\"1-2-1-1-2\" data-name=\"hero headline\" id=\"tool-title\">\n                    Start with a short loop.\n                </h1>\n            </div>\n            <p class=\"max-w-[28ch] border-l border-[var(--br-line)] pl-5 text-[0.95rem] leading-7 text-[var(--br-muted)] lg:mb-2\" data-kid=\"1-2-1-2\" data-name=\"introductory description text\">\n                This is where video selection will begin. The processing workflow has not been implemented yet.\n            </p>\n        </section>\n        <section aria-labelledby=\"upload-placeholder-title\" class=\"mt-14 sm:mt-18\" data-kid=\"1-2-2\" data-name=\"video upload section\">\n            <div class=\"br-mono mb-3 flex items-center justify-between text-[0.61rem] uppercase tracking-[0.12em] text-[var(--br-muted)]\" data-kid=\"1-2-2-1\" data-name=\"frame meta information container\">\n                <span data-kid=\"1-2-2-1-1\" data-name=\"frame name label\">\n                    Frame 01 / input\n                </span>\n                <span class=\"hidden sm:inline\" data-kid=\"1-2-2-1-2\" data-name=\"aspect ratio label desktop\">\n                    Aspect 9:16 / local only\n                </span>\n                <span class=\"sm:hidden\" data-kid=\"1-2-2-1-3\" data-name=\"aspect ratio label mobile\">\n                    9:16 / local\n                </span>\n            </div>\n            <div class=\"relative px-3 py-3 sm:px-5 sm:py-5\" data-kid=\"1-2-2-2\" data-name=\"video placeholder card wrapper\">\n                <span aria-hidden=\"true\" class=\"br-crop-mark br-crop-tl\" data-kid=\"1-2-2-2-1\" data-name=\"top left crop mark\">\n                </span>\n                <span aria-hidden=\"true\" class=\"br-crop-mark br-crop-tr\" data-kid=\"1-2-2-2-2\" data-name=\"top right crop mark\">\n                </span>\n                <span aria-hidden=\"true\" class=\"br-crop-mark br-crop-bl\" data-kid=\"1-2-2-2-3\" data-name=\"bottom left crop mark\">\n                </span>\n                <span aria-hidden=\"true\" class=\"br-crop-mark br-crop-br\" data-kid=\"1-2-2-2-4\" data-name=\"bottom right crop mark\">\n                </span>\n                <div class=\"br-cut-void relative flex aspect-[16/9] w-full flex-col justify-between overflow-hidden border-x border-[var(--br-ink)] bg-[var(--br-ink)] text-[var(--br-paper)]\" data-kid=\"1-2-2-2-5\" data-name=\"video placeholder card\">\n                    <div class=\"relative z-10 flex items-center justify-between border-b border-[var(--br-paper)]/25 px-4 py-3 sm:px-6\" data-kid=\"1-2-2-2-5-1\" data-name=\"video card top bar\">\n                        <span class=\"br-mono text-[0.6rem] uppercase tracking-[0.12em] text-[var(--br-paper)]/70\" data-kid=\"1-2-2-2-5-1-1\" data-name=\"recording status label\">\n                            REC_UNAVAILABLE\n                        </span>\n                        <span class=\"br-mono text-[0.6rem] uppercase tracking-[0.12em] text-[var(--br-paper)]/45\" data-dynamic=\"true\" data-kid=\"1-2-2-2-5-1-2\" data-name=\"timecode display\" data-reason=\"timecode incremented by script\">\n                            TC 00:00:00:00\n                        </span>\n                    </div>\n                    <div class=\"relative z-10 flex flex-1 flex-col items-center justify-center px-5 text-center\" data-kid=\"1-2-2-2-5-2\" data-name=\"video placeholder empty state container\">\n                        <div class=\"mb-5 flex items-center gap-3 sm:mb-6\" data-kid=\"1-2-2-2-5-2-1\" data-name=\"decorative divider container\">\n                            <span class=\"h-px w-8 bg-[var(--br-accent)] sm:w-14\" data-kid=\"1-2-2-2-5-2-1-1\" data-name=\"left line decorator\">\n                            </span>\n                            <span class=\"br-mono text-[0.59rem] uppercase tracking-[0.22em] text-[var(--br-accent)]\" data-kid=\"1-2-2-2-5-2-1-2\" data-name=\"input frame label\">\n                                input frame\n                            </span>\n                            <span class=\"h-px w-8 bg-[var(--br-accent)] sm:w-14\" data-kid=\"1-2-2-2-5-2-1-3\" data-name=\"right line decorator\">\n                            </span>\n                        </div>\n                        <h2 class=\"br-display text-[clamp(2.4rem,6vw,5.6rem)] italic leading-none tracking-[-0.03em] text-[var(--br-paper)]\" data-kid=\"1-2-2-2-5-2-2\" data-name=\"placeholder heading\" id=\"upload-placeholder-title\">\n                            Awaiting loop insertion\n                        </h2>\n                        <p class=\"br-mono mt-4 text-[0.68rem] uppercase tracking-[0.16em] text-[var(--br-paper)]/60\" data-kid=\"1-2-2-2-5-2-3\" data-name=\"placeholder description\">\n                            Not available yet.\n                        </p>\n                    </div>\n                    <div class=\"relative z-10 flex items-center justify-between border-t border-[var(--br-paper)]/25 px-4 py-3 sm:px-6\" data-kid=\"1-2-2-2-5-3\" data-name=\"video card bottom bar\">\n                        <span class=\"br-mono text-[0.6rem] uppercase tracking-[0.12em] text-[var(--br-paper)]/45\" data-dynamic=\"true\" data-kid=\"1-2-2-2-5-3-1\" data-name=\"duration label\" data-reason=\"duration dynamically updated based on video length\">\n                            DUR: --:--\n                        </span>\n                        <span class=\"br-mono text-[0.6rem] uppercase tracking-[0.12em] text-[var(--br-paper)]/70\" data-kid=\"1-2-2-2-5-3-2\" data-name=\"extend mode label\">\n                            EXTEND: NULL\n                        </span>\n                    </div>\n                </div>\n                <div aria-hidden=\"true\" class=\"br-sprocket-row pointer-events-none absolute left-3 right-3 top-[0.8rem] z-20 sm:left-5 sm:right-5 sm:top-[1.3rem]\" data-kid=\"1-2-2-2-6\" data-name=\"top sprocket row\">\n                    <span data-kid=\"1-2-2-2-6-1\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-6-2\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-6-3\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-6-4\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-6-5\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-6-6\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-6-7\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-6-8\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-6-9\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-6-10\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-6-11\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-6-12\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-6-13\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-6-14\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-6-15\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-6-16\">\n                    </span>\n                </div>\n                <div aria-hidden=\"true\" class=\"br-sprocket-row pointer-events-none absolute bottom-[0.8rem] left-3 right-3 z-20 sm:bottom-[1.3rem] sm:left-5 sm:right-5\" data-kid=\"1-2-2-2-7\" data-name=\"bottom sprocket row\">\n                    <span data-kid=\"1-2-2-2-7-1\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-7-2\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-7-3\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-7-4\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-7-5\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-7-6\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-7-7\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-7-8\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-7-9\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-7-10\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-7-11\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-7-12\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-7-13\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-7-14\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-7-15\">\n                    </span>\n                    <span data-kid=\"1-2-2-2-7-16\">\n                    </span>\n                </div>\n            </div>\n        </section>\n        <div class=\"mt-8 border-t border-[var(--br-line)] pt-5 sm:mt-10 sm:flex sm:items-start sm:justify-between sm:gap-8\" data-kid=\"1-2-3\" data-name=\"footer content area\">\n            <p class=\"br-mono max-w-[38ch] text-[0.65rem] uppercase leading-6 tracking-[0.08em] text-[var(--br-muted)]\" data-kid=\"1-2-3-1\" data-name=\"planned flow description\">\n                Planned flow: select → choose a duration → extend locally → save or share.\n            </p>\n            <p class=\"mt-4 max-w-[22ch] text-sm leading-6 text-[var(--br-muted)] sm:mt-0 sm:text-right\" data-kid=\"1-2-3-2\" data-name=\"tool summary text\">\n                A local-first tool for making a short loop hold its place in a longer story.\n            </p>\n        </div>\n    </main>\n</div>\n",
