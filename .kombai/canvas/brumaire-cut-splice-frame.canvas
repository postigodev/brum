    "var_1cf80f21ea88": {
      "type": "variant",
      "label": "Brumaire — Viewfinder Tool",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600&family=Literata:opsz,wght@7..72,400;7..72,500;7..72,600&display=swap');\n\n  :root {\n    --paper: #f1eee6;\n    --paper-soft: #f8f6f0;\n    --ink: #22211e;\n    --muted: #716d64;\n    --line: #cbc5b9;\n    --accent: #755642;\n  }\n\n  .brumaire-viewfinder {\n    font-family: 'DM Sans', 'Avenir Next', Avenir, 'Segoe UI', sans-serif;\n    background: var(--paper);\n    color: var(--ink);\n    min-height: 100vh;\n  }\n\n  .brumaire-display {\n    font-family: 'Literata', 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Palatino, Georgia, serif;\n  }\n\n  .brumaire-mono {\n    font-family: 'DM Mono', 'Courier New', monospace;\n  }\n\n  .crop-mark {\n    position: absolute;\n    width: 38px;\n    height: 38px;\n    pointer-events: none;\n  }\n\n  .crop-mark::before,\n  .crop-mark::after {\n    content: '';\n    position: absolute;\n    background: var(--ink);\n  }\n\n  .crop-mark::before {\n    width: 38px;\n    height: 1px;\n  }\n\n  .crop-mark::after {\n    width: 1px;\n    height: 38px;\n  }\n\n  .crop-mark.tl { left: 0; top: 0; }\n  .crop-mark.tr { right: 0; top: 0; transform: rotate(90deg); transform-origin: top right; }\n  .crop-mark.br { right: 0; bottom: 0; transform: rotate(180deg); transform-origin: bottom right; }\n  .crop-mark.bl { left: 0; bottom: 0; transform: rotate(270deg); transform-origin: bottom left; }\n\n  .crosshair-line-h,\n  .crosshair-line-v {\n    position: absolute;\n    background: var(--accent);\n  }\n\n  .crosshair-line-h { left: 0; top: 50%; width: 100%; height: 1px; }\n  .crosshair-line-v { left: 50%; top: 0; width: 1px; height: 100%; }\n\n  .ruler-tick {\n    display: block;\n    width: 1px;\n    background: var(--muted);\n    opacity: .6;\n  }\n\n  @media (max-width: 767px) {\n    .crop-mark { width: 26px; height: 26px; }\n    .crop-mark::before { width: 26px; }\n    .crop-mark::after { height: 26px; }\n  }\n</style>\n<div class=\"brumaire-viewfinder min-h-screen\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[#cbc5b9]\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto grid min-h-[76px] w-full max-w-[1184px] grid-cols-[1fr_auto_1fr] items-center px-5 sm:px-8\" data-kid=\"1-1-1\" data-name=\"header grid layout\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"app brand section\">\n                <span class=\"brumaire-display text-[1.45rem] leading-none tracking-[-0.045em]\" data-kid=\"1-1-1-1-1\" data-name=\"app name text\">\n                    Brumaire\n                </span>\n                <span class=\"brumaire-mono hidden text-[10px] tracking-[0.08em] text-[#716d64] sm:inline\" data-kid=\"1-1-1-1-2\" data-name=\"utility description text\">\n                    / local loop utility\n                </span>\n            </div>\n            <span class=\"brumaire-mono hidden text-[10px] tracking-[0.12em] text-[#755642] sm:inline\" data-kid=\"1-1-1-2\" data-name=\"system time indicator\">\n                TC 01:00:00:00\n            </span>\n            <nav aria-label=\"Primary navigation\" class=\"justify-self-end text-[11px] uppercase tracking-[0.14em]\" data-kid=\"1-1-1-3\" data-name=\"primary navigation\">\n                <span class=\"inline-flex min-h-11 items-center border-l border-[#cbc5b9] px-4 text-[#22211e]\" data-kid=\"1-1-1-3-1\" data-name=\"navigation link tool\">\n                    Tool\n                </span>\n                <span class=\"inline-flex min-h-11 items-center border-l border-[#cbc5b9] px-4 text-[#716d64]\" data-kid=\"1-1-1-3-2\" data-name=\"navigation link privacy\">\n                    Privacy\n                </span>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[1184px] px-5 pb-16 pt-12 sm:px-8 sm:pb-20 sm:pt-16 lg:pt-20\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section class=\"grid gap-8 border-b border-[#cbc5b9] pb-10 md:grid-cols-[minmax(0,1.15fr)_minmax(260px,0.85fr)] md:items-end md:gap-16\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div data-kid=\"1-2-1-1\" data-name=\"hero text container\">\n                <div class=\"mb-6 flex items-center gap-3 text-[10px] uppercase tracking-[0.17em] text-[#755642]\" data-kid=\"1-2-1-1-1\" data-name=\"hero category label container\">\n                    <span class=\"inline-block h-2 w-2 bg-[#755642]\" data-kid=\"1-2-1-1-1-1\" data-name=\"category label indicator\">\n                    </span>\n                    <span data-kid=\"1-2-1-1-1-2\" data-name=\"category label text\">\n                        Tool / selection surface\n                    </span>\n                </div>\n                <h1 class=\"brumaire-display max-w-[700px] text-[clamp(3.25rem,7vw,6.55rem)] leading-[0.98] tracking-[-0.045em]\" data-kid=\"1-2-1-1-2\" data-name=\"hero headline text\">\n                    Start with a short loop.\n                </h1>\n            </div>\n            <div class=\"max-w-[360px] pb-1 md:justify-self-end\" data-kid=\"1-2-1-2\" data-name=\"hero description container\">\n                <p class=\"text-[1.05rem] leading-[1.62] tracking-[-0.012em] text-[#22211e] sm:text-[1.15rem]\" data-kid=\"1-2-1-2-1\" data-name=\"hero description text\">\n                    This is where video selection will begin. The processing workflow has not been implemented yet.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"upload-placeholder-title\" class=\"mt-10 sm:mt-14\" data-kid=\"1-2-2\" data-name=\"video selection placeholder section\">\n            <div class=\"mb-4 flex items-end justify-between gap-6\" data-kid=\"1-2-2-1\" data-name=\"video selection metadata header\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-1\" data-name=\"safe area label container\">\n                    <span class=\"brumaire-mono text-[10px] tracking-[0.14em] text-[#755642]\" data-kid=\"1-2-2-1-1-1\" data-name=\"safe area label text\">\n                        SAFE AREA\n                    </span>\n                    <span class=\"h-px w-10 bg-[#755642]\" data-kid=\"1-2-2-1-1-2\" data-name=\"safe area divider line\">\n                    </span>\n                </div>\n                <div class=\"brumaire-mono text-[10px] tracking-[0.12em] text-[#716d64]\" data-kid=\"1-2-2-1-2\" data-name=\"frame format indicator\">\n                    FRAME 16:9 / RESERVED\n                </div>\n            </div>\n            <div class=\"relative mx-auto aspect-video w-full bg-[#f8f6f0]\" data-kid=\"1-2-2-2\" data-name=\"video preview placeholder area\">\n                <div class=\"absolute inset-[18px] border border-[#cbc5b9]/70 sm:inset-[26px]\" data-kid=\"1-2-2-2-1\" data-name=\"inner border container\">\n                </div>\n                <span class=\"crop-mark tl\" data-kid=\"1-2-2-2-2\" data-name=\"top-left crop mark\">\n                </span>\n                <span class=\"crop-mark tr\" data-kid=\"1-2-2-2-3\" data-name=\"top-right crop mark\">\n                </span>\n                <span class=\"crop-mark br\" data-kid=\"1-2-2-2-4\" data-name=\"bottom-right crop mark\">\n                </span>\n                <span class=\"crop-mark bl\" data-kid=\"1-2-2-2-5\" data-name=\"bottom-left crop mark\">\n                </span>\n                <div class=\"absolute left-5 top-5 flex items-center gap-3 text-[10px] uppercase tracking-[0.14em] text-[#716d64] sm:left-8 sm:top-7\" data-kid=\"1-2-2-2-6\" data-name=\"video selection status container\">\n                    <span class=\"brumaire-mono\" data-kid=\"1-2-2-2-6-1\" data-name=\"video selection label\">\n                        Video selection\n                    </span>\n                    <span class=\"h-px w-8 bg-[#cbc5b9]\" data-kid=\"1-2-2-2-6-2\" data-name=\"video selection divider\">\n                    </span>\n                    <span class=\"brumaire-mono text-[#755642]\" data-kid=\"1-2-2-2-6-3\" data-name=\"video status text\">\n                        pending\n                    </span>\n                </div>\n                <div class=\"absolute right-5 top-5 text-right text-[10px] leading-[1.7] tracking-[0.08em] text-[#716d64] sm:right-8 sm:top-7\" data-kid=\"1-2-2-2-7\" data-name=\"source metadata container\">\n                    <div class=\"brumaire-mono\" data-kid=\"1-2-2-2-7-1\" data-name=\"source identifier\">\n                        SOURCE / —\n                    </div>\n                    <div class=\"brumaire-mono\" data-kid=\"1-2-2-2-7-2\" data-name=\"duration identifier\">\n                        DURATION / —\n                    </div>\n                </div>\n                <div class=\"absolute left-1/2 top-1/2 flex -translate-x-1/2 -translate-y-1/2 flex-col items-center text-center\" data-kid=\"1-2-2-2-8\" data-name=\"upload prompt container\">\n                    <div aria-hidden=\"true\" class=\"relative size-12 text-[#755642] sm:size-14\" data-kid=\"1-2-2-2-8-1\" data-name=\"crosshair icon\">\n                        <span class=\"crosshair-line-h\" data-kid=\"1-2-2-2-8-1-1\" data-name=\"horizontal crosshair line\">\n                        </span>\n                        <span class=\"crosshair-line-v\" data-kid=\"1-2-2-2-8-1-2\" data-name=\"vertical crosshair line\">\n                        </span>\n                        <span class=\"absolute left-1/2 top-1/2 size-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#755642]\" data-kid=\"1-2-2-2-8-1-3\" data-name=\"center dot\">\n                        </span>\n                    </div>\n                    <h2 class=\"brumaire-display mt-6 whitespace-nowrap text-[clamp(1.9rem,3vw,3.2rem)] leading-none tracking-[-0.035em]\" data-kid=\"1-2-2-2-8-2\" data-name=\"upload placeholder title\" id=\"upload-placeholder-title\">\n                        Video selection\n                    </h2>\n                    <p class=\"mt-3 text-sm text-[#716d64]\" data-kid=\"1-2-2-2-8-3\" data-name=\"upload placeholder subtitle\">\n                        Not available yet.\n                    </p>\n                </div>\n                <div class=\"absolute bottom-5 left-5 flex items-center gap-2 text-[10px] uppercase tracking-[0.12em] text-[#716d64] sm:bottom-7 sm:left-8\" data-kid=\"1-2-2-2-9\" data-name=\"processing indicator container\">\n                    <span class=\"brumaire-mono\" data-kid=\"1-2-2-2-9-1\" data-name=\"processing label text\">\n                        local processing intended\n                    </span>\n                </div>\n                <div class=\"absolute bottom-5 right-5 text-right text-[10px] leading-[1.7] tracking-[0.08em] text-[#716d64] sm:bottom-7 sm:right-8\" data-kid=\"1-2-2-2-10\" data-name=\"extended metadata container\">\n                    <div class=\"brumaire-mono\" data-kid=\"1-2-2-2-10-1\" data-name=\"extend identifier\">\n                        EXTEND / —\n                    </div>\n                    <div class=\"brumaire-mono\" data-kid=\"1-2-2-2-10-2\" data-name=\"output identifier\">\n                        OUTPUT / —\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-4 flex items-center justify-between gap-4 text-[10px] uppercase tracking-[0.13em] text-[#716d64]\" data-kid=\"1-2-2-3\" data-name=\"ruler container\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-3-1\" data-name=\"ruler marks container\">\n                    <span class=\"ruler-tick h-3\" data-kid=\"1-2-2-3-1-1\" data-name=\"ruler tick\">\n                    </span>\n                    <span class=\"ruler-tick h-5\" data-kid=\"1-2-2-3-1-2\" data-name=\"ruler tick\">\n                    </span>\n                    <span class=\"ruler-tick h-3\" data-kid=\"1-2-2-3-1-3\" data-name=\"ruler tick\">\n               