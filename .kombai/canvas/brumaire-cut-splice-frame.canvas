      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap');\n  :root {\n    --paper: #f1eee6;\n    --soft: #faf8f2;\n    --ink: #22211e;\n    --muted: #716d64;\n    --line: #c8c1b5;\n    --accent: #755642;\n  }\n  .font-display-brumaire { font-family: 'Libre Baskerville', Georgia, serif; }\n  .font-body-brumaire { font-family: 'Inter', 'Segoe UI', sans-serif; }\n  .font-mono-brumaire { font-family: 'DM Mono', 'Courier New', monospace; }\n</style>\n<div class=\"min-h-screen bg-[var(--paper)] text-[var(--ink)] font-body-brumaire antialiased\" data-kid=\"1\">\n    <header aria-label=\"Shared navigation\" class=\"border-b border-[var(--line)]\" data-kid=\"1-1\">\n        <div class=\"mx-auto grid h-[76px] max-w-[1280px] grid-cols-[1fr_auto_1fr] items-stretch px-6 sm:px-10 lg:px-14\" data-kid=\"1-1-1\">\n            <a class=\"font-display-brumaire flex min-h-11 items-center text-[1.35rem] tracking-[-0.04em] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)]\" data-kid=\"1-1-1-1\" href=\"#\">\n                Brumaire\n            </a>\n            <div aria-label=\"Static timecode\" class=\"font-mono-brumaire hidden items-center justify-center px-8 text-[10px] uppercase tracking-[0.18em] text-[var(--muted)] sm:flex\" data-dynamic=\"true\" data-kid=\"1-1-1-2\" data-name=\"static timecode display\" data-reason=\"text updated by script to match real-time clock\">\n                TC 01:00:00:00\n            </div>\n            <nav aria-label=\"Primary navigation\" class=\"flex items-stretch justify-end\" data-kid=\"1-1-1-3\">\n                <a class=\"font-mono-brumaire flex min-h-11 items-center border-l border-[var(--line)] px-4 text-[10px] uppercase tracking-[0.16em] text-[var(--muted)] focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-[var(--accent)] sm:px-5\" data-kid=\"1-1-1-3-1\" href=\"#\">\n                    Tool\n                </a>\n                <a class=\"font-mono-brumaire flex min-h-11 items-center border-l border-[var(--line)] px-4 text-[10px] uppercase tracking-[0.16em] text-[var(--muted)] focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-[var(--accent)] sm:px-5\" data-kid=\"1-1-1-3-2\" href=\"#\">\n                    Privacy\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main aria-labelledby=\"tool-title\" class=\"mx-auto w-full max-w-[1280px] px-6 pb-16 pt-10 sm:px-10 sm:pb-20 sm:pt-14 lg:px-14 lg:pt-16\" data-kid=\"1-2\">\n        <div class=\"mb-10 grid grid-cols-2 border-y border-[var(--line)] py-3 sm:grid-cols-4 lg:mb-16 lg:grid-cols-6\" data-kid=\"1-2-1\">\n            <p class=\"font-mono-brumaire text-[9px] uppercase tracking-[0.18em] text-[var(--muted)]\" data-kid=\"1-2-1-1\">\n                BRUMAIRE / TOOL\n            </p>\n            <p class=\"font-mono-brumaire hidden text-[9px] uppercase tracking-[0.18em] text-[var(--muted)] sm:block\" data-kid=\"1-2-1-2\">\n                LOCAL-FIRST UTILITY\n            </p>\n            <p class=\"font-mono-brumaire hidden text-[9px] uppercase tracking-[0.18em] text-[var(--muted)] sm:block lg:col-span-2\" data-kid=\"1-2-1-3\">\n                SOURCE / SHORT LOOP\n            </p>\n            <p class=\"font-mono-brumaire text-right text-[9px] uppercase tracking-[0.18em] text-[var(--accent)]\" data-kid=\"1-2-1-4\">\n                STATE / RESERVED\n            </p>\n        </div>\n        <section class=\"grid grid-cols-1 gap-12 lg:grid-cols-[minmax(250px,0.34fr)_minmax(0,0.66fr)] lg:items-start lg:gap-16\" data-kid=\"1-2-2\">\n            <div class=\"flex flex-col lg:min-h-[510px]\" data-kid=\"1-2-2-1\">\n                <p class=\"font-mono-brumaire mb-6 text-[10px] uppercase tracking-[0.2em] text-[var(--accent)]\" data-kid=\"1-2-2-1-1\">\n                    01 / INPUT\n                </p>\n                <h1 class=\"font-display-brumaire max-w-[14ch] text-[clamp(3.6rem,7vw,6.7rem)] leading-[0.98] tracking-[-0.06em]\" data-kid=\"1-2-2-1-2\" id=\"tool-title\">\n                    Start with a short loop.\n                </h1>\n                <p class=\"mt-8 max-w-[31ch] text-[1.05rem] leading-7 text-[var(--muted)] sm:text-[1.15rem] sm:leading-8\" data-kid=\"1-2-2-1-3\">\n                    This is where video selection will begin. The processing workflow has not been implemented yet.\n                </p>\n                <div class=\"mt-auto hidden border-t border-[var(--line)] pt-5 lg:block\" data-kid=\"1-2-2-1-4\">\n                    <p class=\"font-mono-brumaire mb-4 text-[9px] uppercase tracking-[0.18em] text-[var(--muted)]\" data-kid=\"1-2-2-1-4-1\">\n                        FUTURE SEQUENCE\n                    </p>\n                    <ol class=\"font-mono-brumaire space-y-2 text-[10px] uppercase tracking-[0.12em] text-[var(--ink)]\" data-kid=\"1-2-2-1-4-2\">\n                        <li class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-4-2-1\">\n                            <span class=\"text-[var(--accent)]\" data-kid=\"1-2-2-1-4-2-1-1\">\n                                01\n                            </span>\n                            <span data-kid=\"1-2-2-1-4-2-1-2\">\n                                select\n                            </span>\n                        </li>\n                        <li class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-4-2-2\">\n                            <span class=\"text-[var(--accent)]\" data-kid=\"1-2-2-1-4-2-2-1\">\n                                02\n                            </span>\n                            <span data-kid=\"1-2-2-1-4-2-2-2\">\n                                choose a duration\n                            </span>\n                        </li>\n                        <li class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-4-2-3\">\n                            <span class=\"text-[var(--accent)]\" data-kid=\"1-2-2-1-4-2-3-1\">\n                                03\n                            </span>\n                            <span data-kid=\"1-2-2-1-4-2-3-2\">\n                                extend locally\n                            </span>\n                        </li>\n                        <li class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-4-2-4\">\n                            <span class=\"text-[var(--accent)]\" data-kid=\"1-2-2-1-4-2-4-1\">\n                                04\n                            </span>\n                            <span data-kid=\"1-2-2-1-4-2-4-2\">\n                                save or share\n                            </span>\n                        </li>\n                    </ol>\n                </div>\n            </div>\n            <div class=\"min-w-0\" data-kid=\"1-2-2-2\">\n                <div class=\"mb-4 flex items-end justify-between gap-5 border-b border-[var(--line)] pb-3\" data-kid=\"1-2-2-2-1\">\n                    <p class=\"font-mono-brumaire text-[10px] uppercase tracking-[0.2em] text-[var(--muted)]\" data-kid=\"1-2-2-2-1-1\">\n                        VIDEO SELECTION / OUT-BASKET\n                    </p>\n                    <p class=\"font-mono-brumaire text-right text-[9px] uppercase tracking-[0.16em] text-[var(--accent)]\" data-kid=\"1-2-2-2-1-2\">\n                        SAFE AREA 9:16\n                    </p>\n                </div>\n                <section aria-labelledby=\"upload-placeholder-title\" class=\"relative aspect-[16/9] min-h-[360px] overflow-hidden border-x border-[var(--ink)] border-t-[5px] border-b-[5px] bg-[var(--soft)] sm:min-h-[430px]\" data-kid=\"1-2-2-2-2\">\n                    <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0\" data-kid=\"1-2-2-2-2-1\">\n                        <span class=\"absolute left-4 top-4 h-5 w-5 border-l border-t border-[var(--ink)]\" data-kid=\"1-2-2-2-2-1-1\">\n                        </span>\n                        <span class=\"absolute right-4 top-4 h-5 w-5 border-r border-t border-[var(--ink)]\" data-kid=\"1-2-2-2-2-1-2\">\n                        </span>\n                        <span class=\"absolute bottom-4 left-4 h-5 w-5 border-b border-l border-[var(--ink)]\" data-kid=\"1-2-2-2-2-1-3\">\n                        </span>\n                        <span class=\"absolute bottom-4 right-4 h-5 w-5 border-b border-r border-[var(--ink)]\" data-kid=\"1-2-2-2-2-1-4\">\n                        </span>\n                        <span class=\"absolute left-1/2 top-1/2 h-px w-8 -translate-x-1/2 -translate-y-1/2 bg-[var(--line)]\" data-kid=\"1-2-2-2-2-1-5\">\n                        </span>\n                        <span class=\"absolute left-1/2 top-1/2 h-8 w-px -translate-x-1/2 -translate-y-1/2 bg-[var(--line)]\" data-kid=\"1-2-2-2-2-1-6\">\n                        </span>\n                    </div>\n                    <div class=\"absolute left-5 top-5 flex items-center gap-2 sm:left-7 sm:top-7\" data-kid=\"1-2-2-2-2-2\">\n                        <span aria-hidden=\"true\" class=\"h-2 w-2 rounded-full bg-[var(--accent)]\" data-kid=\"1-2-2-2-2-2-1\">\n                        </span>\n                        <p class=\"font-mono-brumaire text-[9px] uppercase tracking-[0.18em] text-[var(--accent)]\" data-kid=\"1-2-2-2-2-2-2\">\n                            REC_UNAVAILABLE\n                        </p>\n                    </div>\n                    <div class=\"absolute inset-0 flex flex-col items-center justify-center px-8 text-center\" data-kid=\"1-2-2-2-2-3\">\n                        <p class=\"font-mono-brumaire mb-5 text-[9px] uppercase tracking-[0.2em] text-[var(--muted)]\" data-kid=\"1-2-2-2-2-3-1\">\n                            INSERT LOOP / AWAITING SOURCE\n                        </p>\n                        <h2 class=\"font-display-brumaire text-[clamp(2.25rem,5vw,4.6rem)] leading-none tracking-[-0.06em]\" data-kid=\"1-2-2-2-2-3-2\" id=\"upload-placeholder-title\">\n                            Video selection\n                            <span aria-hidden=\"true\" class=\"ml-2 inline-block text-[0.78em] text-[var(--accent)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-3-2-1\" data-name=\"blinking cursor icon\" data-reason=\"opacity toggled by animation to simulate blinking\">\n                                ▮\n                            </span>\n                        </h2>\n                        <p class=\"mt-5 text-sm text-[var(--muted)] sm:text-base\" data-kid=\"1-2-2-2-2-3-3\">\n                            Not available yet.\n                        </p>\n                    </div>\n                    <div class=\"absolute bottom-5 left-5 right-5 flex items-end justify-between gap-5 sm:bottom-7 sm:left-7 sm:right-7\" data-kid=\"1-2-2-2-2-4\">\n                        <p class=\"font-mono-brumaire text-[9px] uppercase tracking-[0.16em] text-[var(--muted)]\" data-kid=\"1-2-2-2-2-4-1\">\n                            FRAME / 16:9\n                            <br data-kid=\"1-2-2-2-2-4-1-1\"/>\n                            <span class=\"text-[var(--ink)]\" data-kid=\"1-2-2-2-2-4-1-2\">\n                                LOCAL PROCESSING PENDING\n                            </span>\n                        </p>\n                        <p class=\"font-mono-brumaire text-right text-[9px] uppercase leading-5 tracking-[0.16em] text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-4-2\" data-name=\"video duration metadata\" data-reason=\"duration updated by processing script\">\n                            DUR: --:--\n                            <br data-kid=\"1-2-2-2-2-4-2-1\"/>\n                            <span class=\"text-[var(--accent)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-4-2-2\" data-name=\"extend metadata status\" data-reason=\"status updated by processing script\">\n                                EXTEND: NULL\n                            </span>\n                        </p>\n                    </div>\n                </section>\n                <div class=\"mt-5 flex flex-col gap-3 border-t border-[var(--line)] pt-4 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-2-2-2-3\">\n                    <p class=\"font-mono-brumaire text-[9px] uppercase tracking-[0.16em] text-[var(--muted)]\" data-kid=\"1-2-2-2-3-1\">\n                        PLANNED FLOW\n                    </p>\n                    <p class=\"text-sm leading-6 text-[var(--muted)] sm:text-right\" data-kid=\"1-2-2-2-3-2\">\n                        select\n                        <span class=\"mx-1 text-[var(--accent)]\" data-kid=\"1-2-2-2-3-2-1\">\n                            →\n                        </span>\n                        choose a duration\n                        <span class=\"mx-1 text-[var(--accent)]\" data-kid=\"1-2-2-2-3-2-2\">\n                            →\n                        </span>\n                        extend locally\n                        <span class=\"mx-1 text-[var(--accent)]\" data-kid=\"1-2-2-2-3-2-3\">\n                            →\n                        </span>\n                        save or share.\n                    </p>\n                </div>\n            </div>\n        </section>\n    </main>\n</div>\n",
