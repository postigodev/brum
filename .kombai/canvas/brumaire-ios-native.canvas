      },
      "html": "<style>\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.34.1/tabler-icons.min.css');\n\n  :root {\n    --ios-bg: #f6f6f8;\n    --ios-surface: #ffffff;\n    --ios-ink: #1c1c1e;\n    --ios-secondary: #8e8e93;\n    --ios-divider: #e5e5ea;\n    --brumaire-orange: #ff9500;\n    --brumaire-orange-soft: #fff1dc;\n  }\n\n  .utility-shell {\n    font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI\", sans-serif;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .utility-shell a {\n    -webkit-tap-highlight-color: transparent;\n  }\n</style>\n<div class=\"utility-shell min-h-screen bg-[var(--ios-bg)] text-[var(--ios-ink)]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"mx-auto flex min-h-16 max-w-[430px] items-center justify-between border-b border-[var(--ios-divider)] px-5\" data-kid=\"1-1\" data-name=\"header navigation bar\">\n        <a aria-label=\"Brumaire home\" class=\"flex min-h-11 items-center text-[1.05rem] font-semibold tracking-[-0.025em]\" data-kid=\"1-1-1\" data-name=\"Brumaire home link\" href=\"/\">\n            Brumaire\n        </a>\n        <nav aria-label=\"Primary navigation\" class=\"flex items-center gap-1 text-[0.84rem] font-medium\" data-kid=\"1-1-2\" data-name=\"primary navigation menu\">\n            <a class=\"flex min-h-11 items-center rounded-lg px-3 text-[var(--brumaire-orange)]\" data-kid=\"1-1-2-1\" data-name=\"tool page navigation link\" href=\"/tool\">\n                Tool\n            </a>\n            <a class=\"flex min-h-11 items-center rounded-lg px-3 text-[var(--ios-secondary)]\" data-kid=\"1-1-2-2\" data-name=\"privacy page navigation link\" href=\"/privacy\">\n                Privacy\n            </a>\n        </nav>\n    </header>\n    <main class=\"mx-auto w-full max-w-[430px] px-5 pb-12 pt-9\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"tool-title\" data-kid=\"1-2-1\" data-name=\"tool introduction section\">\n            <p class=\"mb-3 text-[0.76rem] font-semibold uppercase tracking-[0.08em] text-[var(--brumaire-orange)]\" data-kid=\"1-2-1-1\" data-name=\"section category label\">\n                The tool\n            </p>\n            <h1 class=\"max-w-[340px] text-[2.8rem] font-bold leading-[1.02] tracking-[-0.055em]\" data-kid=\"1-2-1-2\" data-name=\"tool main headline\" id=\"tool-title\">\n                Start with a short loop.\n            </h1>\n            <p class=\"mt-5 max-w-[340px] text-[1.05rem] leading-[1.45] tracking-[-0.01em] text-[var(--ios-secondary)]\" data-kid=\"1-2-1-3\" data-name=\"tool description text\">\n                This is where video selection will begin. The processing workflow has not been implemented yet.\n            </p>\n        </section>\n        <section aria-labelledby=\"selection-title\" class=\"mt-8 rounded-[20px] bg-[var(--ios-surface)] p-3 shadow-[0_1px_2px_rgba(28,28,30,0.04)] ring-1 ring-black/[0.03]\" data-kid=\"1-2-2\" data-name=\"video selection card container\">\n            <div class=\"relative flex min-h-[312px] flex-col items-center justify-center overflow-hidden rounded-[14px] border border-dashed border-[var(--ios-divider)] bg-[var(--ios-bg)] px-6 text-center\" data-kid=\"1-2-2-1\" data-name=\"drag and drop dropzone area\">\n                <div class=\"pointer-events-none absolute left-3 top-3 h-3 w-3 border-l border-t border-[var(--brumaire-orange)]\" data-kid=\"1-2-2-1-1\" data-name=\"top-left decorative corner\">\n                </div>\n                <div class=\"pointer-events-none absolute right-3 top-3 h-3 w-3 border-r border-t border-[var(--brumaire-orange)]\" data-kid=\"1-2-2-1-2\" data-name=\"top-right decorative corner\">\n                </div>\n                <div class=\"pointer-events-none absolute bottom-3 left-3 h-3 w-3 border-b border-l border-[var(--brumaire-orange)]\" data-kid=\"1-2-2-1-3\" data-name=\"bottom-left decorative corner\">\n                </div>\n                <div class=\"pointer-events-none absolute bottom-3 right-3 h-3 w-3 border-b border-r border-[var(--brumaire-orange)]\" data-kid=\"1-2-2-1-4\" data-name=\"bottom-right decorative corner\">\n                </div>\n                <div class=\"mb-5 flex size-14 items-center justify-center rounded-full bg-[var(--brumaire-orange-soft)] text-[var(--brumaire-orange)]\" data-kid=\"1-2-2-1-5\" data-name=\"video icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-video-plus text-[1.65rem]\" data-kid=\"1-2-2-1-5-1\" data-name=\"video plus icon\">\n                    </i>\n                </div>\n                <h2 class=\"text-[1.25rem] font-semibold tracking-[-0.025em]\" data-kid=\"1-2-2-1-6\" data-name=\"video selection title\" id=\"selection-title\">\n                    Video selection\n                </h2>\n                <p class=\"mt-2 text-[0.95rem] text-[var(--ios-secondary)]\" data-kid=\"1-2-2-1-7\" data-name=\"selection availability status\">\n                    Not available yet.\n                </p>\n                <p class=\"mt-5 max-w-[230px] text-[0.78rem] leading-[1.35] text-[var(--ios-secondary)]\" data-kid=\"1-2-2-1-8\" data-name=\"selection info text\">\n                    A real video picker will live here in the next build.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"flow-title\" class=\"mt-7\" data-kid=\"1-2-3\" data-name=\"planned flow section\">\n            <div class=\"mb-2 flex items-end justify-between px-1\" data-kid=\"1-2-3-1\" data-name=\"flow section header\">\n                <h2 class=\"text-[0.78rem] font-semibold uppercase tracking-[0.08em] text-[var(--ios-secondary)]\" data-kid=\"1-2-3-1-1\" data-name=\"flow section title\" id=\"flow-title\">\n                    Planned flow\n                </h2>\n                <span class=\"text-[0.72rem] text-[var(--ios-secondary)]\" data-kid=\"1-2-3-1-2\" data-name=\"future steps label\">\n                    Future steps\n                </span>\n            </div>\n            <div class=\"overflow-hidden rounded-[16px] bg-[var(--ios-surface)] ring-1 ring-black/[0.03]\" data-kid=\"1-2-3-2\" data-name=\"flow steps list container\">\n                <div class=\"flex min-h-14 items-center gap-3 border-b border-[var(--ios-divider)] px-4\" data-kid=\"1-2-3-2-1\" data-name=\"flow step 1 container\">\n                    <span class=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[var(--ios-bg)] text-[var(--ios-secondary)]\" data-kid=\"1-2-3-2-1-1\" data-name=\"step 1 icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-video text-[1rem]\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"video icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[0.98rem]\" data-kid=\"1-2-3-2-1-2\" data-name=\"step 1 label\">\n                        Select\n                    </span>\n                    <span class=\"ml-auto text-[0.78rem] text-[var(--ios-secondary)]\" data-kid=\"1-2-3-2-1-3\" data-name=\"step 1 number\">\n                        01\n                    </span>\n                </div>\n                <div class=\"flex min-h-14 items-center gap-3 border-b border-[var(--ios-divider)] px-4\" data-kid=\"1-2-3-2-2\" data-name=\"flow step 2 container\">\n                    <span class=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[var(--ios-bg)] text-[var(--ios-secondary)]\" data-kid=\"1-2-3-2-2-1\" data-name=\"step 2 icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-clock text-[1rem]\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"clock icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[0.98rem]\" data-kid=\"1-2-3-2-2-2\" data-name=\"step 2 label\">\n                        Choose a duration\n                    </span>\n                    <span class=\"ml-auto text-[0.78rem] text-[var(--ios-secondary)]\" data-kid=\"1-2-3-2-2-3\" data-name=\"step 2 number\">\n                        02\n                    </span>\n                </div>\n                <div class=\"flex min-h-14 items-center gap-3 border-b border-[var(--ios-divider)] px-4\" data-kid=\"1-2-3-2-3\" data-name=\"flow step 3 container\">\n                    <span class=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[var(--ios-bg)] text-[var(--ios-secondary)]\" data-kid=\"1-2-3-2-3-1\" data-name=\"step 3 icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-device-desktop-analytics text-[1rem]\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"desktop analytics icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[0.98rem]\" data-kid=\"1-2-3-2-3-2\" data-name=\"step 3 label\">\n                        Extend locally\n                    </span>\n                    <span class=\"ml-auto text-[0.78rem] text-[var(--ios-secondary)]\" data-kid=\"1-2-3-2-3-3\" data-name=\"step 3 number\">\n                        03\n                    </span>\n                </div>\n                <div class=\"flex min-h-14 items-center gap-3 px-4\" data-kid=\"1-2-3-2-4\" data-name=\"flow step 4 container\">\n                    <span class=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[var(--ios-bg)] text-[var(--ios-secondary)]\" data-kid=\"1-2-3-2-4-1\" data-name=\"step 4 icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-share-3 text-[1rem]\" data-kid=\"1-2-3-2-4-1-1\" data-name=\"share icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[0.98rem]\" data-kid=\"1-2-3-2-4-2\" data-name=\"step 4 label\">\n                        Save or share\n                    </span>\n                    <span class=\"ml-auto text-[0.78rem] text-[var(--ios-secondary)]\" data-kid=\"1-2-3-2-4-3\" data-name=\"step 4 number\">\n                        04\n                    </span>\n                </div>\n            </div>\n        </section>\n        <aside aria-label=\"Local processing note\" class=\"mt-6 flex gap-3 rounded-[16px] bg-[var(--ios-surface)] px-4 py-4 ring-1 ring-black/[0.03]\" data-kid=\"1-2-4\" data-name=\"local processing note section\">\n            <span class=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[var(--brumaire-orange-soft)] text-[var(--brumaire-orange)]\" data-kid=\"1-2-4-1\" data-name=\"note icon container\">\n                <i aria-hidden=\"true\" class=\"ti ti-lock text-[1rem]\" data-kid=\"1-2-4-1-1\" data-name=\"lock icon\">\n                </i>\n            </span>\n            <div data-kid=\"1-2-4-2\" data-name=\"note text container\">\n                <p class=\"text-[0.94rem] font-semibold\" data-kid=\"1-2-4-2-1\" data-name=\"note title\">\n                    Designed to stay local\n                </p>\n                <p class=\"mt-1 text-[0.82rem] leading-[1.4] text-[var(--ios-secondary)]\" data-kid=\"1-2-4-2-2\" data-name=\"note description text\">\n                    Brumaire is intended to process video on your device, without sending the file to a server.\n                </p>\n            </div>\n        </aside>\n    </main>\n</div>\n",
