      },
      "html": "<style>\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.34.1/tabler-icons.min.css');\n\n  .ios-neutral-shell {\n    font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI\", system-ui, sans-serif;\n    -webkit-font-smoothing: antialiased;\n    text-rendering: optimizeLegibility;\n  }\n\n  .ios-neutral-shell a {\n    -webkit-tap-highlight-color: transparent;\n  }\n</style>\n<div class=\"ios-neutral-shell min-h-screen bg-[#F2F2F7] text-[#1C1C1E]\" data-kid=\"1\" data-name=\"ios neutral shell app container\">\n    <header class=\"mx-auto flex min-h-16 w-full max-w-[430px] items-center justify-between border-b border-[#C6C6C8]/70 px-5\" data-kid=\"1-1\" data-name=\"header navigation bar\">\n        <a aria-label=\"Brumaire home\" class=\"flex min-h-11 items-center text-[1.0625rem] font-semibold tracking-[-0.02em]\" data-kid=\"1-1-1\" data-name=\"brumaire logo home link\" href=\"/\">\n            Brumaire\n        </a>\n        <nav aria-label=\"Primary navigation\" class=\"flex items-center gap-1 text-[0.9375rem]\" data-kid=\"1-1-2\" data-name=\"primary navigation menu\">\n            <a class=\"flex min-h-11 items-center rounded-lg px-3 font-medium text-[#007AFF]\" data-kid=\"1-1-2-1\" data-name=\"tool page link\" href=\"/tool\">\n                Tool\n            </a>\n            <a class=\"flex min-h-11 items-center rounded-lg px-3 text-[#8E8E93]\" data-kid=\"1-1-2-2\" data-name=\"privacy page link\" href=\"/privacy\">\n                Privacy\n            </a>\n        </nav>\n    </header>\n    <main class=\"mx-auto w-full max-w-[430px] px-5 pb-12 pt-8\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"tool-title\" data-kid=\"1-2-1\" data-name=\"tool title section\">\n            <h1 class=\"max-w-[350px] text-[2.5rem] font-bold leading-[1.02] tracking-[-0.055em]\" data-kid=\"1-2-1-1\" data-name=\"hero headline text\" id=\"tool-title\">\n                Start with a short loop.\n            </h1>\n            <p class=\"mt-4 max-w-[340px] text-[1.0625rem] leading-[1.45] text-[#8E8E93]\" data-kid=\"1-2-1-2\" data-name=\"tool description text\">\n                This is where video selection will begin. The processing workflow has not been implemented yet.\n            </p>\n        </section>\n        <section aria-labelledby=\"selection-title\" class=\"mt-7 rounded-xl bg-white p-3 ring-1 ring-[#C6C6C8]/35\" data-kid=\"1-2-2\" data-name=\"video selection section\">\n            <div class=\"flex min-h-[300px] flex-col items-center justify-center rounded-lg border border-[#E5E5EA] bg-[#F2F2F7] px-6 text-center\" data-kid=\"1-2-2-1\" data-name=\"video selection drop zone placeholder\">\n                <i aria-hidden=\"true\" class=\"ti ti-video-plus mb-4 text-[1.5rem] text-[#007AFF]\" data-kid=\"1-2-2-1-1\" data-name=\"video plus icon\">\n                </i>\n                <h2 class=\"text-[1.0625rem] font-semibold tracking-[-0.015em]\" data-kid=\"1-2-2-1-2\" data-name=\"video selection section title\" id=\"selection-title\">\n                    Video selection\n                </h2>\n                <p class=\"mt-2 text-[0.9375rem] text-[#8E8E93]\" data-kid=\"1-2-2-1-3\" data-name=\"video selection status text\">\n                    Not available yet.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"flow-title\" class=\"mt-7\" data-kid=\"1-2-3\" data-name=\"planned flow section\">\n            <h2 class=\"mb-2 px-1 text-[0.8125rem] font-medium text-[#8E8E93]\" data-kid=\"1-2-3-1\" data-name=\"planned flow section title\" id=\"flow-title\">\n                Planned flow\n            </h2>\n            <div class=\"overflow-hidden rounded-xl bg-white ring-1 ring-[#C6C6C8]/35\" data-kid=\"1-2-3-2\" data-name=\"planned flow items container\">\n                <div class=\"flex min-h-14 items-center border-b border-[#C6C6C8]/55 px-4 text-[1.0625rem]\" data-kid=\"1-2-3-2-1\" data-name=\"select step item\">\n                    Select\n                </div>\n                <div class=\"flex min-h-14 items-center border-b border-[#C6C6C8]/55 px-4 text-[1.0625rem]\" data-kid=\"1-2-3-2-2\" data-name=\"choose duration step item\">\n                    Choose a duration\n                </div>\n                <div class=\"flex min-h-14 items-center border-b border-[#C6C6C8]/55 px-4 text-[1.0625rem]\" data-kid=\"1-2-3-2-3\" data-name=\"extend locally step item\">\n                    Extend locally\n                </div>\n                <div class=\"flex min-h-14 items-center px-4 text-[1.0625rem]\" data-kid=\"1-2-3-2-4\" data-name=\"save or share step item\">\n                    Save or share\n                </div>\n            </div>\n        </section>\n        <aside aria-label=\"Local processing note\" class=\"mt-6 flex gap-3 rounded-xl bg-white px-4 py-4 ring-1 ring-[#C6C6C8]/35\" data-kid=\"1-2-4\" data-name=\"local processing note aside\">\n            <i aria-hidden=\"true\" class=\"ti ti-lock mt-0.5 shrink-0 text-[1.0625rem] text-[#8E8E93]\" data-kid=\"1-2-4-1\" data-name=\"lock icon\">\n            </i>\n            <div data-kid=\"1-2-4-2\" data-name=\"note text container\">\n                <p class=\"text-[1rem] font-semibold tracking-[-0.01em]\" data-kid=\"1-2-4-2-1\" data-name=\"note headline text\">\n                    Designed to stay local\n                </p>\n                <p class=\"mt-1 text-[0.875rem] leading-[1.4] text-[#8E8E93]\" data-kid=\"1-2-4-2-2\" data-name=\"note body text\">\n                    Brumaire is intended to process video on your device, without sending the file to a server.\n                </p>\n            </div>\n        </aside>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-08-11T20:04:06.562295+00:00",
