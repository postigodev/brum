    "var_b8e82a9aeb01": {
      "type": "variant",
      "label": "Brumaire — iOS Native Compact",
      "parentId": "var_0a72354ee75d",
      "themeId": null,
      "rect": {
        "x": 3430,
        "y": 0,
        "w": 390,
        "h": 812
      },
      "html": "<style>\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.34.1/tabler-icons.min.css');\n\n  :root {\n    --ios-bg: #f2f2f7;\n    --ios-surface: #ffffff;\n    --ios-ink: #1c1c1e;\n    --ios-secondary: #8e8e93;\n    --ios-divider: #c6c6c8;\n    --ios-accent: #007aff;\n  }\n\n  .ios-compact-shell {\n    font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"SF Pro Display\", \"Segoe UI\", system-ui, sans-serif;\n    -webkit-font-smoothing: antialiased;\n    text-rendering: optimizeLegibility;\n  }\n\n  .ios-compact-shell a {\n    -webkit-tap-highlight-color: transparent;\n  }\n</style>\n<div class=\"ios-compact-shell min-h-screen bg-[var(--ios-bg)] text-[var(--ios-ink)]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"mx-auto flex min-h-16 w-full max-w-[430px] items-center justify-between border-b border-[var(--ios-divider)] px-4\" data-kid=\"1-1\" data-name=\"header container\">\n        <a aria-label=\"Brumaire home\" class=\"flex min-h-11 items-center text-[1.05rem] font-semibold tracking-[-0.025em]\" data-kid=\"1-1-1\" data-name=\"site brand name link\" href=\"/\">\n            Brumaire\n        </a>\n        <nav aria-label=\"Primary navigation\" class=\"flex items-center gap-1 text-[0.84rem] font-medium\" data-kid=\"1-1-2\" data-name=\"primary navigation bar\">\n            <a class=\"flex min-h-11 items-center rounded-full bg-[#e5f0ff] px-3 text-[var(--ios-accent)]\" data-kid=\"1-1-2-1\" data-name=\"active tool navigation link\" href=\"/tool\">\n                Tool\n            </a>\n            <a class=\"flex min-h-11 items-center rounded-lg px-3 text-[var(--ios-secondary)]\" data-kid=\"1-1-2-2\" data-name=\"privacy policy navigation link\" href=\"/privacy\">\n                Privacy\n            </a>\n        </nav>\n    </header>\n    <main class=\"mx-auto w-full max-w-[430px] px-4 pb-10 pt-6\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"tool-title\" data-kid=\"1-2-1\" data-name=\"hero information section\">\n            <p class=\"mb-2 text-[0.76rem] font-medium text-[var(--ios-secondary)]\" data-kid=\"1-2-1-1\" data-name=\"section label text\">\n                The tool\n            </p>\n            <h1 class=\"max-w-[340px] text-[2.65rem] font-bold leading-[1.03] tracking-[-0.055em]\" data-kid=\"1-2-1-2\" data-name=\"hero headline text\" id=\"tool-title\">\n                Start with a short loop.\n            </h1>\n            <p class=\"mt-4 max-w-[350px] text-[1rem] leading-[1.45] tracking-[-0.01em] text-[var(--ios-secondary)]\" data-kid=\"1-2-1-3\" data-name=\"description text\">\n                This is where video selection will begin. The processing workflow has not been implemented yet.\n            </p>\n        </section>\n        <section aria-labelledby=\"selection-title\" class=\"mt-6 rounded-2xl bg-[var(--ios-surface)] p-3 shadow-[0_1px_2px_rgba(28,28,30,0.04)] ring-1 ring-black/[0.03]\" data-kid=\"1-2-2\" data-name=\"video selection section container\">\n            <div class=\"flex min-h-[280px] flex-col items-center justify-center rounded-[14px] border border-[var(--ios-divider)] bg-[var(--ios-bg)] px-5 text-center\" data-kid=\"1-2-2-1\" data-name=\"video upload placeholder box\">\n                <div class=\"mb-4 flex size-12 items-center justify-center rounded-full bg-[var(--ios-surface)] text-[var(--ios-accent)] shadow-[0_1px_2px_rgba(28,28,30,0.06)]\" data-kid=\"1-2-2-1-1\" data-name=\"icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-video-plus text-[1.45rem]\" data-kid=\"1-2-2-1-1-1\" data-name=\"video plus icon\">\n                    </i>\n                </div>\n                <h2 class=\"text-[1.2rem] font-semibold tracking-[-0.025em]\" data-kid=\"1-2-2-1-2\" data-name=\"section heading title\" id=\"selection-title\">\n                    Video selection\n                </h2>\n                <p class=\"mt-1.5 text-[0.95rem] text-[var(--ios-secondary)]\" data-kid=\"1-2-2-1-3\" data-name=\"availability status text\">\n                    Not available yet.\n                </p>\n                <p class=\"mt-4 max-w-[235px] text-[0.78rem] leading-[1.35] text-[var(--ios-secondary)]\" data-kid=\"1-2-2-1-4\" data-name=\"informational note text\">\n                    A real video picker will live here in the next build.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"flow-title\" class=\"mt-6\" data-kid=\"1-2-3\" data-name=\"planned flow section\">\n            <h2 class=\"mb-2 px-1 text-[0.76rem] font-medium text-[var(--ios-secondary)]\" data-kid=\"1-2-3-1\" data-name=\"section label heading\" id=\"flow-title\">\n                Planned flow\n            </h2>\n            <div class=\"overflow-hidden rounded-2xl bg-[var(--ios-surface)] ring-1 ring-black/[0.03]\" data-kid=\"1-2-3-2\" data-name=\"flow steps list container\">\n                <div class=\"flex min-h-[52px] items-center gap-3 border-b border-[var(--ios-divider)] px-4\" data-kid=\"1-2-3-2-1\" data-name=\"first flow step row\">\n                    <span class=\"w-6 text-[0.78rem] text-[var(--ios-secondary)]\" data-kid=\"1-2-3-2-1-1\" data-name=\"step number text\">\n                        01\n                    </span>\n                    <span class=\"text-[0.98rem]\" data-kid=\"1-2-3-2-1-2\" data-name=\"step description text\">\n                        Select\n                    </span>\n                </div>\n                <div class=\"flex min-h-[52px] items-center gap-3 border-b border-[var(--ios-divider)] px-4\" data-kid=\"1-2-3-2-2\" data-name=\"second flow step row\">\n                    <span class=\"w-6 text-[0.78rem] text-[var(--ios-secondary)]\" data-kid=\"1-2-3-2-2-1\" data-name=\"step number text\">\n                        02\n                    </span>\n                    <span class=\"text-[0.98rem]\" data-kid=\"1-2-3-2-2-2\" data-name=\"step description text\">\n                        Choose a duration\n                    </span>\n                </div>\n                <div class=\"flex min-h-[52px] items-center gap-3 border-b border-[var(--ios-divider)] px-4\" data-kid=\"1-2-3-2-3\" data-name=\"third flow step row\">\n                    <span class=\"w-6 text-[0.78rem] text-[var(--ios-secondary)]\" data-kid=\"1-2-3-2-3-1\" data-name=\"step number text\">\n                        03\n                    </span>\n                    <span class=\"text-[0.98rem]\" data-kid=\"1-2-3-2-3-2\" data-name=\"step description text\">\n                        Extend locally\n                    </span>\n                </div>\n                <div class=\"flex min-h-[52px] items-center gap-3 px-4\" data-kid=\"1-2-3-2-4\" data-name=\"fourth flow step row\">\n                    <span class=\"w-6 text-[0.78rem] text-[var(--ios-secondary)]\" data-kid=\"1-2-3-2-4-1\" data-name=\"step number text\">\n                        04\n                    </span>\n                    <span class=\"text-[0.98rem]\" data-kid=\"1-2-3-2-4-2\" data-name=\"step description text\">\n                        Save or share\n                    </span>\n                </div>\n            </div>\n        </section>\n        <aside aria-label=\"Local processing note\" class=\"mt-5 border-y border-[var(--ios-divider)] px-1 py-4\" data-kid=\"1-2-4\" data-name=\"local processing notice container\">\n            <p class=\"text-[0.88rem] leading-[1.45] text-[var(--ios-secondary)]\" data-kid=\"1-2-4-1\" data-name=\"notice text\">\n                <strong class=\"font-semibold text-[var(--ios-ink)]\" data-kid=\"1-2-4-1-1\" data-name=\"emphasized notice text\">\n                    Designed to stay local.\n                </strong>\n                Brumaire is intended to process video on your device, without sending the file to a server.\n            </p>\n        </aside>\n    </main>\n</div>\n",
