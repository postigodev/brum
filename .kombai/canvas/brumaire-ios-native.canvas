      "html": "<style>\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/tabler-icons.min.css');\n  \n  .brumaire-dark-media {\n    -webkit-font-smoothing: antialiased;\n    text-rendering: optimizeLegibility;\n  }\n</style>\n<div class=\"brumaire-dark-media min-h-screen bg-[#000000] px-5 pb-10 font-sans text-[#FFFFFF]\" data-kid=\"1\" data-name=\"dark theme page container\">\n    <header class=\"mx-auto flex min-h-16 max-w-md items-center justify-between border-b border-[#38383A]\" data-kid=\"1-1\" data-name=\"header navigation section\">\n        <a class=\"inline-flex min-h-11 items-center gap-2 text-[17px] font-semibold tracking-[-0.02em] text-white no-underline\" data-kid=\"1-1-1\" data-name=\"brand identity logo\" href=\"#\">\n            <span data-kid=\"1-1-1-1\" data-name=\"brand name\">\n                Brumaire\n            </span>\n            <span aria-hidden=\"true\" class=\"size-1.5 rounded-full bg-[#32D74B]\" data-kid=\"1-1-1-2\" data-name=\"status indicator dot\">\n            </span>\n        </a>\n        <nav aria-label=\"Primary navigation\" class=\"flex items-center gap-1 text-[13px] font-medium\" data-kid=\"1-1-2\" data-name=\"primary navigation links\">\n            <a aria-current=\"page\" class=\"inline-flex min-h-11 items-center rounded-full bg-[#1C1C1E] px-4 text-[#FFFFFF] no-underline\" data-kid=\"1-1-2-1\" data-name=\"active tool navigation link\" href=\"#tool\">\n                Tool\n            </a>\n            <a class=\"inline-flex min-h-11 items-center rounded-full px-3 text-[#8E8E93] no-underline\" data-kid=\"1-1-2-2\" data-name=\"privacy navigation link\" href=\"#privacy\">\n                Privacy\n            </a>\n        </nav>\n    </header>\n    <main class=\"mx-auto max-w-md pt-9\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"flex items-center justify-between text-[11px] font-semibold uppercase tracking-[0.12em] text-[#8E8E93]\" data-kid=\"1-2-1\" data-name=\"header meta info row\">\n            <span data-kid=\"1-2-1-1\" data-name=\"utility category label\">\n                Video extender\n            </span>\n            <span class=\"text-[#32D74B]\" data-kid=\"1-2-1-2\" data-name=\"local-first badge\">\n                Local-first\n            </span>\n        </div>\n        <h1 class=\"mt-5 max-w-[330px] text-[44px] font-semibold leading-[1.04] tracking-[-0.055em] text-white\" data-kid=\"1-2-2\" data-name=\"hero headline\">\n            Start with a short loop.\n        </h1>\n        <p class=\"mt-5 max-w-[340px] text-[17px] leading-[1.45] tracking-[-0.01em] text-[#AEAEB2]\" data-kid=\"1-2-3\" data-name=\"introductory description paragraph\">\n            This is where video selection will begin. The processing workflow has not been implemented yet.\n        </p>\n        <section aria-labelledby=\"upload-title\" class=\"mt-8 rounded-[24px] border border-[#2C2C2E] bg-[#1C1C1E] p-3\" data-kid=\"1-2-4\" data-name=\"video upload section\">\n            <div class=\"rounded-[18px] border border-[#38383A] bg-[#121214] px-4 py-5\" data-kid=\"1-2-4-1\" data-name=\"video drop zone container\">\n                <div class=\"flex items-center justify-between text-[11px] font-medium uppercase tracking-[0.1em] text-[#8E8E93]\" data-kid=\"1-2-4-1-1\" data-name=\"video selection status header\">\n                    <span data-kid=\"1-2-4-1-1-1\" data-name=\"video selection label\">\n                        Video selection\n                    </span>\n                    <span class=\"text-[#32D74B]\" data-kid=\"1-2-4-1-1-2\" data-name=\"reserved status badge\">\n                        Reserved\n                    </span>\n                </div>\n                <div class=\"flex min-h-[222px] flex-col items-center justify-center text-center\" data-kid=\"1-2-4-1-2\" data-name=\"video selection prompt content\">\n                    <span aria-hidden=\"true\" class=\"mb-5 inline-flex size-14 items-center justify-center rounded-full bg-[#1C1C1E] text-[24px] text-[#32D74B]\" data-kid=\"1-2-4-1-2-1\" data-name=\"video icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-photo-video\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"photo-video icon\">\n                        </i>\n                    </span>\n                    <h2 class=\"text-[21px] font-semibold tracking-[-0.025em] text-white\" data-kid=\"1-2-4-1-2-2\" data-name=\"video selection title\" id=\"upload-title\">\n                        Video selection\n                    </h2>\n                    <p class=\"mt-2 text-[15px] leading-6 text-[#AEAEB2]\" data-kid=\"1-2-4-1-2-3\" data-name=\"video selection availability description\">\n                        Not available yet.\n                    </p>\n                </div>\n                <div class=\"flex items-center justify-between border-t border-[#38383A] pt-4 text-[12px] text-[#8E8E93]\" data-kid=\"1-2-4-1-3\" data-name=\"video input status footer\">\n                    <span data-kid=\"1-2-4-1-3-1\" data-name=\"input label\">\n                        Input\n                    </span>\n                    <span data-kid=\"1-2-4-1-3-2\" data-name=\"input status text\">\n                        Waiting for a video\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"planned-flow-title\" class=\"mt-8\" data-kid=\"1-2-5\" data-name=\"planned workflow section\">\n            <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-2-5-1\" data-name=\"workflow section header\">\n                <h2 class=\"text-[13px] font-semibold text-white\" data-kid=\"1-2-5-1-1\" data-name=\"planned flow title\" id=\"planned-flow-title\">\n                    Planned flow\n                </h2>\n                <span class=\"text-[12px] text-[#8E8E93]\" data-kid=\"1-2-5-1-2\" data-name=\"coming later badge\">\n                    Coming later\n                </span>\n            </div>\n            <div class=\"overflow-hidden rounded-[18px] border border-[#2C2C2E] bg-[#1C1C1E]\" data-kid=\"1-2-5-2\" data-name=\"workflow steps container\">\n                <div class=\"flex min-h-14 items-center gap-3 border-b border-[#38383A] px-4\" data-kid=\"1-2-5-2-1\" data-name=\"first workflow step row\">\n                    <span class=\"flex size-7 shrink-0 items-center justify-center rounded-full bg-[#2C2C2E] text-[12px] font-semibold text-[#32D74B]\" data-kid=\"1-2-5-2-1-1\" data-name=\"step number one\">\n                        1\n                    </span>\n                    <span class=\"text-[15px] text-white\" data-kid=\"1-2-5-2-1-2\" data-name=\"step one description\">\n                        Select\n                    </span>\n                    <i aria-hidden=\"true\" class=\"ti ti-chevron-right ml-auto text-[18px] text-[#636366]\" data-kid=\"1-2-5-2-1-3\" data-name=\"chevron right icon\">\n                    </i>\n                </div>\n                <div class=\"flex min-h-14 items-center gap-3 border-b border-[#38383A] px-4\" data-kid=\"1-2-5-2-2\" data-name=\"second workflow step row\">\n                    <span class=\"flex size-7 shrink-0 items-center justify-center rounded-full bg-[#2C2C2E] text-[12px] font-semibold text-[#AEAEB2]\" data-kid=\"1-2-5-2-2-1\" data-name=\"step number two\">\n                        2\n                    </span>\n                    <span class=\"text-[15px] text-white\" data-kid=\"1-2-5-2-2-2\" data-name=\"step two description\">\n                        Choose a duration\n                    </span>\n                    <i aria-hidden=\"true\" class=\"ti ti-chevron-right ml-auto text-[18px] text-[#636366]\" data-kid=\"1-2-5-2-2-3\" data-name=\"chevron right icon\">\n                    </i>\n                </div>\n                <div class=\"flex min-h-14 items-center gap-3 border-b border-[#38383A] px-4\" data-kid=\"1-2-5-2-3\" data-name=\"third workflow step row\">\n                    <span class=\"flex size-7 shrink-0 items-center justify-center rounded-full bg-[#2C2C2E] text-[12px] font-semibold text-[#AEAEB2]\" data-kid=\"1-2-5-2-3-1\" data-name=\"step number three\">\n                        3\n                    </span>\n                    <span class=\"text-[15px] text-white\" data-kid=\"1-2-5-2-3-2\" data-name=\"step three description\">\n                        Extend locally\n                    </span>\n                    <i aria-hidden=\"true\" class=\"ti ti-chevron-right ml-auto text-[18px] text-[#636366]\" data-kid=\"1-2-5-2-3-3\" data-name=\"chevron right icon\">\n                    </i>\n                </div>\n                <div class=\"flex min-h-14 items-center gap-3 px-4\" data-kid=\"1-2-5-2-4\" data-name=\"fourth workflow step row\">\n                    <span class=\"flex size-7 shrink-0 items-center justify-center rounded-full bg-[#2C2C2E] text-[12px] font-semibold text-[#AEAEB2]\" data-kid=\"1-2-5-2-4-1\" data-name=\"step number four\">\n                        4\n                    </span>\n                    <span class=\"text-[15px] text-white\" data-kid=\"1-2-5-2-4-2\" data-name=\"step four description\">\n                        Save or share\n                    </span>\n                    <i aria-hidden=\"true\" class=\"ti ti-chevron-right ml-auto text-[18px] text-[#636366]\" data-kid=\"1-2-5-2-4-3\" data-name=\"chevron right icon\">\n                    </i>\n                </div>\n            </div>\n        </section>\n        <aside class=\"mt-8 flex gap-3 border-t border-[#38383A] pt-5\" data-kid=\"1-2-6\" data-name=\"privacy assurance aside\">\n            <span aria-hidden=\"true\" class=\"mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-[#1C1C1E] text-[17px] text-[#AEAEB2]\" data-kid=\"1-2-6-1\" data-name=\"lock icon container\">\n                <i aria-hidden=\"true\" class=\"ti ti-lock\" data-kid=\"1-2-6-1-1\" data-name=\"lock icon\">\n                </i>\n            </span>\n            <div data-kid=\"1-2-6-2\" data-name=\"privacy statement text block\">\n                <p class=\"text-[14px] font-medium text-white\" data-kid=\"1-2-6-2-1\" data-name=\"privacy feature title\">\n                    Designed to stay local\n                </p>\n                <p class=\"mt-1 text-[14px] leading-6 text-[#8E8E93]\" data-kid=\"1-2-6-2-2\" data-name=\"privacy feature description\">\n                    Brumaire is intended to process video on your device, without sending the file to a server.\n                </p>\n            </div>\n        </aside>\n    </main>\n</div>\n",
