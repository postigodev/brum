      "html": "<style>\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.34.1/tabler-icons.min.css');\n\n  .ios-native-blue {\n    font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"SF Pro Display\", \"Segoe UI\", sans-serif;\n    -webkit-font-smoothing: antialiased;\n    text-rendering: optimizeLegibility;\n  }\n\n  .ios-native-blue a {\n    -webkit-tap-highlight-color: transparent;\n  }\n</style>\n<div class=\"ios-native-blue min-h-screen bg-[#F2F2F7] text-[#1C1C1E]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"mx-auto flex min-h-16 w-full max-w-[430px] items-center justify-between border-b border-[#C6C6C8]/60 bg-[#F2F2F7] px-5\" data-kid=\"1-1\" data-name=\"header container\">\n        <a aria-label=\"Brumaire home\" class=\"flex min-h-11 items-center text-[1.05rem] font-semibold tracking-[-0.02em]\" data-kid=\"1-1-1\" data-name=\"site title\" href=\"/\">\n            Brumaire\n        </a>\n        <nav aria-label=\"Primary navigation\" class=\"flex items-center gap-1 text-[0.88rem] font-medium\" data-kid=\"1-1-2\" data-name=\"primary navigation menu\">\n            <a class=\"flex min-h-11 items-center rounded-lg px-3 text-[#007AFF]\" data-kid=\"1-1-2-1\" data-name=\"tool navigation link\" href=\"/tool\">\n                Tool\n            </a>\n            <a class=\"flex min-h-11 items-center rounded-lg px-3 text-[#007AFF]\" data-kid=\"1-1-2-2\" data-name=\"privacy navigation link\" href=\"/privacy\">\n                Privacy\n            </a>\n        </nav>\n    </header>\n    <main class=\"mx-auto w-full max-w-[430px] px-5 pb-12 pt-9\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"tool-title\" data-kid=\"1-2-1\" data-name=\"introductory section\">\n            <p class=\"mb-3 text-[0.82rem] font-medium text-[#8E8E93]\" data-kid=\"1-2-1-1\" data-name=\"section label\">\n                The tool\n            </p>\n            <h1 class=\"max-w-[340px] text-[2.8rem] font-bold leading-[1.04] tracking-[-0.055em]\" data-kid=\"1-2-1-2\" data-name=\"hero headline\" id=\"tool-title\">\n                Start with a short loop.\n            </h1>\n            <p class=\"mt-5 max-w-[340px] text-[1.06rem] leading-[1.45] tracking-[-0.01em] text-[#8E8E93]\" data-kid=\"1-2-1-3\" data-name=\"hero description\">\n                This is where video selection will begin. The processing workflow has not been implemented yet.\n            </p>\n        </section>\n        <section aria-labelledby=\"selection-title\" class=\"mt-8 rounded-[16px] bg-white p-3 shadow-[0_1px_2px_rgba(0,0,0,0.04)]\" data-kid=\"1-2-2\" data-name=\"video selection drop zone container\">\n            <div class=\"relative flex min-h-[312px] flex-col items-center justify-center rounded-[12px] border border-dashed border-[#C6C6C8] px-6 text-center\" data-kid=\"1-2-2-1\" data-name=\"drop zone area\">\n                <div class=\"mb-5 flex size-14 items-center justify-center rounded-full bg-[#E5F0FF] text-[#007AFF]\" data-kid=\"1-2-2-1-1\" data-name=\"icon wrapper\">\n                    <i aria-hidden=\"true\" class=\"ti ti-video-plus text-[1.65rem]\" data-kid=\"1-2-2-1-1-1\" data-name=\"video plus icon\">\n                    </i>\n                </div>\n                <h2 class=\"text-[1.22rem] font-semibold tracking-[-0.025em]\" data-kid=\"1-2-2-1-2\" data-name=\"video selection heading\" id=\"selection-title\">\n                    Video selection\n                </h2>\n                <p class=\"mt-2 text-[0.96rem] text-[#8E8E93]\" data-kid=\"1-2-2-1-3\" data-name=\"status text\">\n                    Not available yet.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"flow-title\" class=\"mt-7\" data-kid=\"1-2-3\" data-name=\"planned flow section\">\n            <h2 class=\"mb-2 px-1 text-[0.82rem] font-medium text-[#8E8E93]\" data-kid=\"1-2-3-1\" data-name=\"planned flow heading\" id=\"flow-title\">\n                Planned flow\n            </h2>\n            <div class=\"overflow-hidden rounded-[16px] bg-white\" data-kid=\"1-2-3-2\" data-name=\"flow steps container\">\n                <div class=\"flex min-h-14 items-center gap-3 border-b border-[#C6C6C8]/70 px-4\" data-kid=\"1-2-3-2-1\" data-name=\"select step container\">\n                    <span class=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[#F2F2F7] text-[#007AFF]\" data-kid=\"1-2-3-2-1-1\" data-name=\"select step icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-video text-[1rem]\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"video icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[1.02rem]\" data-kid=\"1-2-3-2-1-2\" data-name=\"select step label\">\n                        Select\n                    </span>\n                </div>\n                <div class=\"flex min-h-14 items-center gap-3 border-b border-[#C6C6C8]/70 px-4\" data-kid=\"1-2-3-2-2\" data-name=\"duration step container\">\n                    <span class=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[#F2F2F7] text-[#007AFF]\" data-kid=\"1-2-3-2-2-1\" data-name=\"duration step icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-clock text-[1rem]\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"clock icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[1.02rem]\" data-kid=\"1-2-3-2-2-2\" data-name=\"duration step label\">\n                        Choose a duration\n                    </span>\n                </div>\n                <div class=\"flex min-h-14 items-center gap-3 border-b border-[#C6C6C8]/70 px-4\" data-kid=\"1-2-3-2-3\" data-name=\"extend step container\">\n                    <span class=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[#F2F2F7] text-[#007AFF]\" data-kid=\"1-2-3-2-3-1\" data-name=\"extend step icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-device-desktop-analytics text-[1rem]\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"analytics icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[1.02rem]\" data-kid=\"1-2-3-2-3-2\" data-name=\"extend step label\">\n                        Extend locally\n                    </span>\n                </div>\n                <div class=\"flex min-h-14 items-center gap-3 px-4\" data-kid=\"1-2-3-2-4\" data-name=\"save step container\">\n                    <span class=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[#F2F2F7] text-[#007AFF]\" data-kid=\"1-2-3-2-4-1\" data-name=\"save step icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-share-3 text-[1rem]\" data-kid=\"1-2-3-2-4-1-1\" data-name=\"share icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[1.02rem]\" data-kid=\"1-2-3-2-4-2\" data-name=\"save step label\">\n                        Save or share\n                    </span>\n                </div>\n            </div>\n        </section>\n        <aside aria-label=\"Local processing note\" class=\"mt-6 flex gap-3 rounded-[16px] bg-white px-4 py-4\" data-kid=\"1-2-4\" data-name=\"privacy note section\">\n            <span class=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[#F2F2F7] text-[#8E8E93]\" data-kid=\"1-2-4-1\" data-name=\"lock icon container\">\n                <i aria-hidden=\"true\" class=\"ti ti-lock text-[1rem]\" data-kid=\"1-2-4-1-1\" data-name=\"lock icon\">\n                </i>\n            </span>\n            <div data-kid=\"1-2-4-2\" data-name=\"privacy note text container\">\n                <p class=\"text-[0.98rem] font-semibold\" data-kid=\"1-2-4-2-1\" data-name=\"privacy note heading\">\n                    Designed to stay local\n                </p>\n                <p class=\"mt-1 text-[0.84rem] leading-[1.4] text-[#8E8E93]\" data-kid=\"1-2-4-2-2\" data-name=\"privacy note description\">\n                    Brumaire is intended to process video on your device, without sending the file to a server.\n                </p>\n            </div>\n        </aside>\n    </main>\n</div>\n",
