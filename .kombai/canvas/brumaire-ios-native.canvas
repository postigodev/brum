      "html": "<style>\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n  :root {\n    --ios-bg: #f2f2f7;\n    --ios-surface: #ffffff;\n    --ios-ink: #000000;\n    --ios-secondary: #8e8e93;\n    --ios-separator: #c6c6c8;\n    --ios-border: #e5e5ea;\n    --ios-blue: #007aff;\n  }\n</style>\n<div class=\"min-h-screen bg-[var(--ios-bg)] font-sans text-[var(--ios-ink)] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', system-ui, sans-serif;\">\n    <header class=\"border-b border-[var(--ios-separator)]/60 bg-[var(--ios-bg)] px-5 pb-3 pt-3\" data-kid=\"1-1\" data-name=\"header navigation bar\">\n        <div class=\"flex min-h-11 items-center justify-between\" data-kid=\"1-1-1\" data-name=\"header layout container\">\n            <a class=\"flex min-h-11 items-center text-[1.2rem] font-semibold tracking-[-0.035em] text-[var(--ios-ink)] no-underline\" data-kid=\"1-1-1-1\" data-name=\"brand name link\" href=\"#\">\n                Brumaire\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"flex items-center gap-1 text-[0.84rem] font-medium\" data-kid=\"1-1-1-2\" data-name=\"navigation menu\">\n                <a class=\"flex min-h-11 items-center rounded-full bg-[var(--ios-blue)]/10 px-3 text-[var(--ios-blue)] no-underline\" data-kid=\"1-1-1-2-1\" data-name=\"active navigation link\" href=\"#tool\">\n                    Tool\n                </a>\n                <a class=\"flex min-h-11 items-center rounded-full px-3 text-[var(--ios-blue)] no-underline\" data-kid=\"1-1-1-2-2\" data-name=\"navigation link\" href=\"#privacy\">\n                    Privacy\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[430px] px-5 pb-12 pt-8\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"tool-title\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <p class=\"mb-3 text-[0.8rem] font-medium text-[var(--ios-secondary)]\" data-kid=\"1-2-1-1\" data-name=\"hero label\">\n                Video utility\n            </p>\n            <h1 class=\"max-w-[330px] text-[2.65rem] font-semibold leading-[1.04] tracking-[-0.055em]\" data-kid=\"1-2-1-2\" data-name=\"hero title\" id=\"tool-title\">\n                Start with a short loop.\n            </h1>\n            <p class=\"mt-4 max-w-[340px] text-[1.05rem] leading-[1.42] tracking-[-0.01em] text-[var(--ios-secondary)]\" data-kid=\"1-2-1-3\" data-name=\"hero description\">\n                This is where video selection will begin. The processing workflow has not been implemented yet.\n            </p>\n        </section>\n        <section aria-labelledby=\"selection-title\" class=\"mt-7 rounded-[20px] border border-[var(--ios-border)] bg-[var(--ios-surface)] p-3 shadow-[0_1px_2px_rgba(0,0,0,0.04)]\" data-kid=\"1-2-2\" data-name=\"selection card container\">\n            <div class=\"flex min-h-[292px] flex-col items-center justify-center rounded-[15px] border border-dashed border-[var(--ios-separator)] px-6 text-center\" data-kid=\"1-2-2-1\" data-name=\"selection drop zone container\">\n                <div class=\"mb-5 flex size-16 items-center justify-center rounded-full bg-[var(--ios-blue)]/10 text-[1.75rem] text-[var(--ios-blue)]\" data-kid=\"1-2-2-1-1\" data-name=\"icon wrapper\">\n                    <i aria-hidden=\"true\" class=\"ti ti-photo-video\" data-kid=\"1-2-2-1-1-1\" data-name=\"photo video icon\">\n                    </i>\n                </div>\n                <p class=\"mb-2 text-[0.72rem] font-semibold uppercase tracking-[0.08em] text-[var(--ios-secondary)]\" data-kid=\"1-2-2-1-2\" data-name=\"drop zone label\">\n                    Selection surface\n                </p>\n                <h2 class=\"text-[1.2rem] font-semibold tracking-[-0.02em]\" data-kid=\"1-2-2-1-3\" data-name=\"drop zone title\" id=\"selection-title\">\n                    Video selection\n                </h2>\n                <p class=\"mt-1.5 text-[0.95rem] leading-6 text-[var(--ios-secondary)]\" data-kid=\"1-2-2-1-4\" data-name=\"drop zone description\">\n                    Not available yet.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"planned-flow-title\" class=\"mt-8\" data-kid=\"1-2-3\" data-name=\"planned flow section\">\n            <h2 class=\"mb-2 px-1 text-[0.82rem] font-medium text-[var(--ios-secondary)]\" data-kid=\"1-2-3-1\" data-name=\"planned flow section title\" id=\"planned-flow-title\">\n                Planned flow\n            </h2>\n            <div class=\"overflow-hidden rounded-[17px] border border-[var(--ios-border)] bg-[var(--ios-surface)]\" data-kid=\"1-2-3-2\" data-name=\"flow step list container\">\n                <div class=\"flex min-h-14 items-center gap-3 border-b border-[var(--ios-border)] px-4\" data-kid=\"1-2-3-2-1\" data-name=\"flow step 1 container\">\n                    <span class=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[var(--ios-bg)] text-[1.05rem] text-[var(--ios-blue)]\" data-kid=\"1-2-3-2-1-1\" data-name=\"step icon wrapper\">\n                        <i aria-hidden=\"true\" class=\"ti ti-video\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"video icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[1rem]\" data-kid=\"1-2-3-2-1-2\" data-name=\"step 1 text\">\n                        Select\n                    </span>\n                </div>\n                <div class=\"flex min-h-14 items-center gap-3 border-b border-[var(--ios-border)] px-4\" data-kid=\"1-2-3-2-2\" data-name=\"flow step 2 container\">\n                    <span class=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[var(--ios-bg)] text-[1.05rem] text-[var(--ios-blue)]\" data-kid=\"1-2-3-2-2-1\" data-name=\"step icon wrapper\">\n                        <i aria-hidden=\"true\" class=\"ti ti-clock\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"clock icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[1rem]\" data-kid=\"1-2-3-2-2-2\" data-name=\"step 2 text\">\n                        Choose a duration\n                    </span>\n                </div>\n                <div class=\"flex min-h-14 items-center gap-3 border-b border-[var(--ios-border)] px-4\" data-kid=\"1-2-3-2-3\" data-name=\"flow step 3 container\">\n                    <span class=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[var(--ios-bg)] text-[1.05rem] text-[var(--ios-blue)]\" data-kid=\"1-2-3-2-3-1\" data-name=\"step icon wrapper\">\n                        <i aria-hidden=\"true\" class=\"ti ti-cpu\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"cpu icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[1rem]\" data-kid=\"1-2-3-2-3-2\" data-name=\"step 3 text\">\n                        Extend locally\n                    </span>\n                </div>\n                <div class=\"flex min-h-14 items-center gap-3 px-4\" data-kid=\"1-2-3-2-4\" data-name=\"flow step 4 container\">\n                    <span class=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[var(--ios-bg)] text-[1.05rem] text-[var(--ios-blue)]\" data-kid=\"1-2-3-2-4-1\" data-name=\"step icon wrapper\">\n                        <i aria-hidden=\"true\" class=\"ti ti-share-3\" data-kid=\"1-2-3-2-4-1-1\" data-name=\"share icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[1rem]\" data-kid=\"1-2-3-2-4-2\" data-name=\"step 4 text\">\n                        Save or share\n                    </span>\n                </div>\n            </div>\n        </section>\n        <aside aria-label=\"Privacy note\" class=\"mt-5 flex items-start gap-3 rounded-[17px] border border-[var(--ios-border)] bg-[var(--ios-surface)] px-4 py-4\" data-kid=\"1-2-4\" data-name=\"privacy note section\">\n            <span class=\"mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-[var(--ios-bg)] text-[1.05rem] text-[var(--ios-secondary)]\" data-kid=\"1-2-4-1\" data-name=\"privacy icon wrapper\">\n                <i aria-hidden=\"true\" class=\"ti ti-lock\" data-kid=\"1-2-4-1-1\" data-name=\"lock icon\">\n                </i>\n            </span>\n            <div data-kid=\"1-2-4-2\" data-name=\"privacy content container\">\n                <p class=\"text-[0.98rem] font-medium\" data-kid=\"1-2-4-2-1\" data-name=\"privacy title\">\n                    Designed to stay local\n                </p>\n                <p class=\"mt-1 text-[0.9rem] leading-5 text-[var(--ios-secondary)]\" data-kid=\"1-2-4-2-2\" data-name=\"privacy description\">\n                    Brumaire is intended to process video on your device, without sending the file to a server.\n                </p>\n            </div>\n        </aside>\n    </main>\n</div>\n",
