      },
      "html": "<style>\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.34.1/tabler-icons.min.css');\n\n  .ios-neutral-home {\n    font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI\", system-ui, sans-serif;\n    -webkit-font-smoothing: antialiased;\n    text-rendering: optimizeLegibility;\n  }\n\n  .ios-neutral-home a {\n    -webkit-tap-highlight-color: transparent;\n  }\n</style>\n<div class=\"ios-neutral-home min-h-screen bg-[#F2F2F7] text-[#1C1C1E]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"mx-auto flex min-h-16 w-full max-w-[430px] items-center justify-between border-b border-[#C6C6C8]/70 px-5\" data-kid=\"1-1\" data-name=\"header container\">\n        <a aria-label=\"Brumaire home\" class=\"flex min-h-11 items-center text-[1.0625rem] font-semibold tracking-[-0.02em]\" data-kid=\"1-1-1\" data-name=\"home link\" href=\"/\">\n            Brumaire\n        </a>\n        <nav aria-label=\"Primary navigation\" class=\"flex items-center gap-1 text-[0.9375rem]\" data-kid=\"1-1-2\" data-name=\"primary navigation menu\">\n            <a class=\"flex min-h-11 items-center rounded-lg px-3 text-[#8E8E93]\" data-kid=\"1-1-2-1\" data-name=\"tool navigation link\" href=\"/tool\">\n                Tool\n            </a>\n            <a class=\"flex min-h-11 items-center rounded-lg px-3 text-[#8E8E93]\" data-kid=\"1-1-2-2\" data-name=\"privacy navigation link\" href=\"/privacy\">\n                Privacy\n            </a>\n        </nav>\n    </header>\n    <main class=\"mx-auto w-full max-w-[430px] px-5 pb-12 pt-10\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"home-title\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <p class=\"text-[0.8125rem] font-medium text-[#8E8E93]\" data-kid=\"1-2-1-1\" data-name=\"subheadline text\">\n                Short loop, longer story\n            </p>\n            <h1 class=\"mt-3 max-w-[350px] text-[3.25rem] font-bold leading-[0.96] tracking-[-0.06em]\" data-kid=\"1-2-1-2\" data-name=\"page title\" id=\"home-title\">\n                Brumaire\n            </h1>\n            <p class=\"mt-5 max-w-[350px] text-[1.0625rem] leading-[1.45] text-[#8E8E93]\" data-kid=\"1-2-1-3\" data-name=\"description text\">\n                A focused tool in development for extending short videos and Boomerangs to the length your story needs.\n            </p>\n            <div class=\"mt-8 flex flex-col items-stretch gap-3\" data-kid=\"1-2-1-4\" data-name=\"cta container\">\n                <a class=\"flex min-h-12 items-center justify-center gap-3 rounded-xl bg-[#007AFF] px-5 text-[1rem] font-semibold text-white\" data-kid=\"1-2-1-4-1\" data-name=\"call-to-action button\" href=\"/tool\">\n                    <span data-kid=\"1-2-1-4-1-1\" data-name=\"call-to-action button label\">\n                        Open the tool\n                    </span>\n                    <span aria-hidden=\"true\" class=\"text-[1.125rem] leading-none\" data-kid=\"1-2-1-4-1-2\" data-name=\"arrow icon\">\n                        →\n                    </span>\n                </a>\n                <p class=\"px-1 text-[0.875rem] leading-[1.4] text-[#8E8E93]\" data-kid=\"1-2-1-4-2\" data-name=\"availability notice text\">\n                    The processing flow is not available yet.\n                </p>\n            </div>\n        </section>\n        <aside aria-label=\"Privacy note\" class=\"mt-8 flex gap-3 rounded-xl bg-white px-4 py-4 ring-1 ring-[#C6C6C8]/35\" data-kid=\"1-2-2\" data-name=\"privacy note card\">\n            <i aria-hidden=\"true\" class=\"ti ti-lock mt-0.5 shrink-0 text-[1.0625rem] text-[#8E8E93]\" data-kid=\"1-2-2-1\" data-name=\"lock icon\">\n            </i>\n            <div data-kid=\"1-2-2-2\" data-name=\"privacy note content\">\n                <p class=\"text-[1rem] font-semibold tracking-[-0.01em]\" data-kid=\"1-2-2-2-1\" data-name=\"privacy note title\">\n                    Designed to stay local\n                </p>\n                <p class=\"mt-1 text-[0.875rem] leading-[1.4] text-[#8E8E93]\" data-kid=\"1-2-2-2-2\" data-name=\"privacy note description text\">\n                    Brumaire is intended to process video on your device, without sending the file to a server.\n                </p>\n            </div>\n        </aside>\n    </main>\n</div>\n",
